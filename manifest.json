{
  "manifest_version": 3,
  "name": "LinkedIn Notas",
  "version": "1.1.0",
  "description": "Añade, edita y elimina comentarios privados sobre personas en LinkedIn, guardados en ficheros Markdown locales.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "LinkedIn Notas: configurar fichero"
  }
}
